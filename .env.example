# Supabase — copy to .env.local and fill with your project values.
# Never commit real keys. The anon key is safe for the browser (RLS enforces read-only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Gemini API Key — Dành cho BOW Agent V3 (Lấy miễn phí tại https://aistudio.google.com/)
# VITE_GEMINI_API_KEY dùng cho client-side dev/test
VITE_GEMINI_API_KEY=
# GEMINI_API_KEY dùng cho backend proxy serverless function
GEMINI_API_KEY=

# ============================================================
# Netlify Functions (server-side only — KHÔNG có tiền tố VITE_,
# không bao giờ lộ ra browser). Đặt trong Netlify > Site settings
# > Environment variables.
# ============================================================

# Telegram — thông báo đơn hàng mới (netlify/functions/telegram-notify.ts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SePay webhook — tự động xác nhận chuyển khoản (netlify/functions/sepay-webhook.ts)
# SUPABASE_SERVICE_ROLE_KEY: lấy ở Supabase > Project Settings > API > service_role
#   (BÍ MẬT tuyệt đối — bỏ qua RLS, chỉ dùng server-side).
# SEPAY_API_KEY: chuỗi bí mật bạn tự đặt, khai báo trùng trong SePay > Webhooks
#   để xác thực header "Authorization: Apikey <SEPAY_API_KEY>".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEPAY_API_KEY=

# INTERNAL_API_KEY: chuỗi bí mật bạn tự đặt (vd: chuỗi random 32+ ký tự).
#   Dùng cho telegram-notify.ts — DB trigger gọi function server→server và
#   phải gửi kèm header "Authorization: Apikey <INTERNAL_API_KEY>".
#   Giá trị này phải TRÙNG với secret 'internal_api_key' lưu trong Supabase Vault
#   (xem cuối migration 0010_secure_order_notifications.sql).
INTERNAL_API_KEY=
